# Copy this file to .env. The defaults below run everything on your own computer.

# ---- Database -------------------------------------------------------------
# Leave empty to use the embedded local PostgreSQL (stored in .data/pglite).
# For Neon, paste the pooled connection string from the Neon dashboard, for example:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Better Auth ----------------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-before-deploying
BETTER_AUTH_URL=http://localhost:3000

# ---- Blockchain -----------------------------------------------------------
# local   = Hardhat development chain started with `pnpm chain` (chain id 31337)
# sepolia = Ethereum Sepolia testnet
CHAIN=local
RPC_URL=http://127.0.0.1:8545

# Twelve-word recovery phrase from which every seeded wallet is derived
# (account 0 = registrar and deployer, account 1 = server relayer, accounts 2 and up = seeded users).
# The default is the public Hardhat test phrase: fine for `CHAIN=local`, NEVER use it on a real network.
# For Sepolia, create a NEW phrase in MetaMask that you use for nothing else and paste it here.
WALLET_MNEMONIC="test test test test test test test test test test test junk"

# Sepolia only: how much test ETH (in ETH) the seed script sends from account 0 to each seeded wallet.
SEED_FUND_ETH=0.002

# Filled in automatically by `pnpm contract:deploy` (deployments/<chain>.json). Set it only to override.
CONTRACT_ADDRESS=
