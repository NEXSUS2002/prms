  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "hardhat": "^3.22.0",
    "nitro": "3.0.261103-rc",
    "solc": "^0.8.38",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "description": "Decentralised, unified electronic health records system (PRMS) - final-year project",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "chain": "hardhat node",
    "contract:compile": "tsx scripts/compile-contract.ts",
    "contract:deploy": "tsx scripts/deploy-contract.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "bootstrap": "pnpm contract:compile && pnpm contract:deploy && pnpm db:migrate && pnpm seed",
    "test": "vitest run",
    "wallets": "tsx scripts/wallets.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "demo:refresh": "tsx scripts/demo-refresh.ts",
    "secret:rotate": "tsx scripts/rotate-secret.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.28.0"
}
